{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd app && npm install",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/en/terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/google49754703d50db677.html",
      "destination": "/google49754703d50db677"
    },
    {
      "source": "/:lang(en|es)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en|es)/:doc(privacy|terms)",
      "destination": "/:lang/:doc/index.html"
    }
  ],
  "headers": [
    {
      "source": "/google49754703d50db677.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(wave-sunset-.*|favicon.*|icon-.*|apple-touch-icon.png|og.jpg|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(en|es)(/privacy|/terms)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
